<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kutu_robot">

  <!-- Ana Govde (base_link) -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.076" ixy="0.0" ixz="0.0" iyy="0.159" iyz="0.0" izz="0.216"/>
    </inertial>
  </link>






  <!-- Sag Tekerlek -->
  <link name="sag_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0021" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="sag_teker_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sag_teker"/>
    <origin xyz="0.1 -0.23 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Sol Tekerlek -->
  <link name="sol_teker">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.0021" ixy="0" ixz="0" iyy="0.0021" iyz="0" izz="0.004"/>
    </inertial>
  </link>

  <joint name="sol_teker_joint" type="continuous">
    <parent link="base_link"/>
    <child link="sol_teker"/>
    <origin xyz="0.1 0.23 -0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Arka Sarhos Tekerlek (Denge Icin) -->
  <link name="sarhos_teker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="sarhos_teker_joint" type="fixed">
    <parent link="base_link"/>
    <child link="sarhos_teker"/>
    <origin xyz="-0.2 0 -0.1" rpy="0 0 0"/>
  </joint>



  <!-- Kamera -->
  <link name="kamera_link">
    <visual>
      <geometry>
	<box size= "0.05 0.05 0.05"/>
      </geometry>
      <material name= "red">
	<color rgba= "1 0 0 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
	<box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>
    <inertail>
      <mass value ="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertail>
  </link>

  <joint name= "kamera_joint" type = "fixed">
    <parent link="base_link"/>
    <child link= "kamera_link"/>
    <origin xyz="0.25 0 0.1" rpy="0 0 0"/>	
  </joint>

  <gazebo reference= "kamera_link">
    <material>Gazebo/Red</material>
    <sensor type = "camera" name = "robot_kamerasi">
      <update_rate>30.0</update_rate>
      <camera name="kafa">
	<horizontal_fov> 1.3962634</horizontal_fov>
	<image>
	  <width>640</width>
	  <height>480</height>
	  <format>R8G8B8</format>
	</image>
	<clip>
	  <near>0.02</near>
	  <far>300</far>
	</clip>

      </camera>
      
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
	<alwaysOn>true</alwaysOn>
	<updateRate>0.0</updateRate>
	<cameraName>robot/kamera</cameraName>
	<imageTopicName>image_raw</imageTopicName>
	<cameraInfoTopicName>camera_info</cameraInfoTopicName>
	<frameName>kamera_link</frameName>

      </plugin>
    </sensor>
  </gazebo>



  <!-- Gazebo Renk & Fizik Tanimlari -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="sag_teker">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="sol_teker">
    <material>Gazebo/FlatBlack</material>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="sarhos_teker">
    <material>Gazebo/Grey</material>
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>

  <!-- Gazebo Diferansiyel Surus Motor Plugin'i -->
  <gazebo>
    <plugin name="differential_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <rosDebugLevel>na</rosDebugLevel>
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <leftJoint>sol_teker_joint</leftJoint>
      <rightJoint>sag_teker_joint</rightJoint>
      <wheelSeparation>0.46</wheelSeparation>
      <wheelDiameter>0.2</wheelDiameter>
      <torque>20</torque>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_link</robotBaseFrame>
      <publishWheelTF>false</publishWheelTF>
      <publishOdomTF>true</publishOdomTF>
      <publishWheelJointState>true</publishWheelJointState>
    </plugin>
  </gazebo>

  <xacro:include filename="$(find project_ulgen)/urdf/lidar.xacro"/>


</robot>


